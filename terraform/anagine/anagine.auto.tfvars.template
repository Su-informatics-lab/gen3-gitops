# Copy this file to anagine.auto.tfvars and select the AWS profile that
# owns the ardac2prd cluster. The copied .tfvars file is ignored by Git.
#
# Initialize the partial backend before planning or applying:
#
#   terraform init \
#     -backend-config="bucket=ardac-portal-terraform-state-705452667" \
#     -backend-config="key=ardac2prd/anagine/terraform.tfstate"

prefix       = "ardac2prd"
cluster_name = "ardac2prd"
bucket_name  = "ardac2prd-anagine-reports"

# Leave these at their defaults unless the Helm release changes.
# anagine_namespace       = "default"
# anagine_service_account = "anagine"

# Set this only when the default AWS credential chain is not appropriate.
# aws_profile = "ardac2prd"
